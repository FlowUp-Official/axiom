{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AxiomConfig",
  "type": "object",
  "required": [
    "cache",
    "inputs",
    "outputs",
    "project",
    "validation"
  ],
  "properties": {
    "$schema": {
      "description": "URL pointing to the Axiom JSON schema version, e.g. `https://raw.githubusercontent.com/FlowUp-Official/axiom/v0.5.0/schemas/axiom.schema.json`.",
      "type": [
        "string",
        "null"
      ]
    },
    "project": {
      "$ref": "#/definitions/ProjectConfig"
    },
    "cache": {
      "$ref": "#/definitions/CacheConfig"
    },
    "inputs": {
      "$ref": "#/definitions/InputsConfig"
    },
    "validation": {
      "$ref": "#/definitions/ValidationConfig"
    },
    "outputs": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/OutputConfig"
      }
    }
  },
  "definitions": {
    "ProjectConfig": {
      "type": "object",
      "required": [
        "dialect",
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "dialect": {
          "type": "string"
        }
      }
    },
    "CacheConfig": {
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "path": {
          "default": ".axiom.cache",
          "type": "string"
        }
      }
    },
    "InputsConfig": {
      "type": "object",
      "required": [
        "queries",
        "schema"
      ],
      "properties": {
        "schema": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "queries": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "ValidationConfig": {
      "type": "object",
      "required": [
        "on_error"
      ],
      "properties": {
        "on_error": {
          "type": "string"
        }
      }
    },
    "OutputConfig": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "path",
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "typescript"
              ]
            },
            "path": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "path",
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "rust"
              ]
            },
            "path": {
              "type": "string"
            }
          }
        }
      ]
    }
  }
}
